{
  "name": "shaggar-chamber-web",
  "version": "1.0.0",
  "private": true,
  "description": "Shagar Chamber website and admin panel (Next.js)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push && node --env-file-if-exists=.env.local scripts/lock-public-api.mjs",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "upload-files": "node --env-file-if-exists=.env.local scripts/upload-files-to-supabase.mjs",
    "copy-from-mysql": "node --env-file-if-exists=.env.local scripts/copy-from-mysql.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "@supabase/server": "1.9.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "mysql2": "3.24.6"
  }
}
