# Copy to .env.local for local development, or enter these in your host's
# environment settings (Render → Environment, Vercel → Settings → Environment Variables).

# Supabase project (Project Settings → API Keys). The secret key is server-only:
# never give it a NEXT_PUBLIC_ name, those are sent to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Database connection for Drizzle (server only). Supabase → Connect:
#  - Render / your own server: "Session pooler" (port 5432)
#  - Vercel: "Transaction pooler" (port 6543)
# Replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres

# Optional: a session-mode or direct connection for `npm run db:push`, when
# SUPABASE_DB_URL is the transaction pooler.
# DATABASE_MIGRATION_URL=

# Optional: private Storage bucket for ID photos, receipts and CVs (created automatically).
# SUPABASE_BUCKET=shagar-member-documents

# Optional, only for `npm run copy-from-mysql` (moving data from the old database):
# MYSQL_URL=mysql://user:password@host:4000/shagar_chamber?ssl=true
