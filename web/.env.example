# Copy to .env.local for local development, or enter these in your
# host's environment settings (e.g. Vercel → Project → Settings → Environment Variables).

# Database. Local XAMPP: host 127.0.0.1, port 3306, user root, DB_SSL=false.
# TiDB Cloud: its host, port 4000, your TiDB user/password, and no DB_SSL line.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shagar_chamber
DB_SSL=false

# Uploaded ID photos, receipts and CVs. Required online: hosts like Vercel do
# not keep files on disk. Without these, files are saved in UPLOAD_DIR.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=shagar-member-documents
# UPLOAD_DIR=uploads
