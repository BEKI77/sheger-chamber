# Copy this file to ".env" (in this backend folder) and fill in the values.

# Required. Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

PORT=5000

# Other websites allowed to call this API (comma separated). Not needed when
# the site is opened from this server itself or from localhost.
# CORS_ORIGINS=https://shagarchamber.com,https://www.shagarchamber.com

# Local XAMPP MySQL (defaults shown). For TiDB Cloud use its host,
# port 4000, your TiDB user/password, and remove DB_SSL=false.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shagar_chamber
DB_SSL=false

# Optional: permanent upload storage (needed on hosts that wipe the disk).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=shagar-member-documents
